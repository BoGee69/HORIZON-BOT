N8N_PORT=5678
N8N_PROTOCOL=http
N8N_HOST=localhost
N8N_WEBHOOK_PUBLIC_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false

# Required: generated locally in n8n/.env.
N8N_ENCRYPTION_KEY=replace-with-64-hex-chars
