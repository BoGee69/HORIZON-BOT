DATA_DIR="/data"
SQLITE_PATH="/data/games.db"
# AI provider
AI_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_THINK=medium
OLLAMA_KEEP_ALIVE=5m
GEMINI_API_KEY=

# AI caretaker
# Enable only after the selected provider API key is set in your .env file.
AI_MAINTENANCE_ENABLED=false
AI_MAINTENANCE_PROVIDER=ollama
AI_MAINTENANCE_MODEL=gpt-oss:120b
AI_MAINTENANCE_INTERVAL_MINUTES=360
AI_MAINTENANCE_ALERT_IDS=
AI_MAINTENANCE_MAX_PROMPT_CHARS=12000
AI_MAINTENANCE_DM_ON_OK=false
AI_MAINTENANCE_DM_ON_WARNING=true
AI_MAINTENANCE_DM_ON_CRITICAL=true
AI_MAINTENANCE_COOLDOWN_SECONDS=900
AI_MAINTENANCE_START_DELAY_SECONDS=20

# Personal DM chat with TriadBot
AI_CHAT_ENABLED=false
AI_CHAT_ALLOWED_IDS=
# true = user with Discord Administrator permission or ADMIN_ROLE_NAMES/IDS can DM chat with TriadBot
AI_CHAT_ALLOW_DISCORD_ADMINS=true
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=gpt-oss:120b
AI_CHAT_MAX_HISTORY=12
AI_CHAT_MAX_REPLY_CHARS=1800
AI_CHAT_COOLDOWN_SECONDS=3
AI_CHAT_MAX_MESSAGE_CHARS=1800
AI_CHAT_R2_STATS_ENABLED=true
AI_CHAT_R2_STATS_CACHE_SECONDS=900
AI_CHAT_R2_STATS_MAX_PAGES=2000
AI_CHAT_SERVER_REPLIES_ENABLED=true
AI_CHAT_SERVER_REQUIRE_MENTION=true
# true = public server replies are info-only. No operator actions, proposal approval, R2/database internals, logs, or secrets are exposed in channels.
AI_CHAT_PUBLIC_INFO_ONLY=true
AI_CHAT_SERVER_KNOWLEDGE_ENABLED=true
AI_CHAT_SERVER_KNOWLEDGE_CACHE_SECONDS=600
AI_CHAT_SERVER_KNOWLEDGE_MAX_MESSAGES=12
AI_CHAT_SERVER_KNOWLEDGE_MAX_CHARS=9000
AI_CHAT_SERVER_KNOWLEDGE_CHANNEL_NAMES=rules,rule,server-rules,resources,resource,panduan,guide,guides,announcement,announcements,pengumuman,link-invite,welcome

# Attachment reading for owner DMs
# Text files/docx/pdf can be read directly. Image OCR needs a vision-capable provider.
AI_ATTACHMENT_ENABLED=true
AI_ATTACHMENT_OCR_ENABLED=true
AI_ATTACHMENT_MAX_BYTES=8388608
AI_ATTACHMENT_MAX_TEXT_CHARS=12000
AI_ATTACHMENT_CACHE_SECONDS=900
AI_ATTACHMENT_VISION_PROVIDER=gemini
AI_ATTACHMENT_VISION_MODEL=gemini-2.5-flash-lite

# Owner-approved AI operator
# The AI can propose whitelisted maintenance actions, but changes run only after owner approval.
AI_OPERATOR_ENABLED=false
AI_OPERATOR_ALLOWED_IDS=
# true = Discord server Owner/Admin role or Administrator permission can use the operator in DM.
AI_OPERATOR_ALLOW_DISCORD_ADMINS=true
# true = operator/approval/database/server-management prompts only work in DM, never in public channels.
AI_OPERATOR_DM_ONLY=true
# false = public server channels cannot create/approve operator proposals by prompt. Public channels are info-only.
AI_OPERATOR_SERVER_PROMPTS_ENABLED=false
# Kept for backwards compatibility if AI_OPERATOR_DM_ONLY=false, but DM-only should stay true for production.
AI_OPERATOR_SERVER_REQUIRE_MENTION=true
AI_OPERATOR_REQUIRE_CONFIRMATION=true
AI_OPERATOR_APPROVAL_TTL_SECONDS=900
AI_OPERATOR_PROPOSAL_COOLDOWN_SECONDS=1800
AI_OPERATOR_MAX_PENDING=10
AI_OPERATOR_ALLOW_R2_MAINTENANCE=true
AI_OPERATOR_ALLOW_STEAM_DB_SYNC=true
AI_OPERATOR_ALLOW_AI_RECHECK=true
AI_OPERATOR_ALLOW_SERVER_AUDIT=true
AI_OPERATOR_ALLOW_BOOSTER_SYNC=true
AI_OPERATOR_ALLOW_SEND_ANNOUNCEMENT=true
AI_OPERATOR_ALLOW_UPDATE_RULES=true
AI_OPERATOR_ALLOW_PIN_MESSAGE=true
AI_OPERATOR_ALLOW_SET_CHANNEL_TOPIC=true
AI_OPERATOR_ALLOW_CREATE_CHANNEL=true
AI_OPERATOR_ALLOW_CONFIGURE_CHANNEL_ACCESS=true
AI_OPERATOR_ALLOW_SETUP_CHANNEL_TEMPLATE=true
AI_OPERATOR_ALLOW_CREATE_ROLE=true
AI_OPERATOR_ALLOW_UPDATE_ROLE=true
AI_OPERATOR_ALLOW_DELETE_ROLE=false
AI_OPERATOR_ALLOW_MEMBER_TIMEOUT=true
AI_OPERATOR_ALLOW_MEMBER_KICK=false
AI_OPERATOR_ALLOW_MEMBER_BAN=false
AI_OPERATOR_ALLOW_WEBHOOK_CREATE=true
AI_OPERATOR_ALLOW_WEBHOOK_DELETE=false
AI_OPERATOR_ALLOW_SERVER_SETTING=false
AI_OPERATOR_ALLOW_SCHEDULE_ACTION=true
AI_OPERATOR_SCHEDULER_ENABLED=true
AI_OPERATOR_SCHEDULE_CHECK_SECONDS=60
AI_OPERATOR_SCHEDULES_PATH=data/ai_operator_schedules.json

# Discord server caretaker
# Read-only audits can run automatically. Server-changing actions still require owner approval.
SERVER_ADMIN_ENABLED=false
SERVER_ADMIN_GUILD_IDS=
SERVER_ADMIN_AUDIT_ON_START=true
SERVER_ADMIN_AUDIT_INTERVAL_HOURS=6
SERVER_ADMIN_START_DELAY_SECONDS=30
SERVER_ADMIN_ALERT_ON_ISSUES=true
SERVER_ADMIN_RULES_CHANNEL_NAMES=rules,rule,server-rules
SERVER_ADMIN_ANNOUNCEMENT_CHANNEL_NAMES=announcement,announcements,pengumuman
SERVER_ADMIN_REQUIRED_PERMISSIONS=administrator,manage_roles,manage_channels,send_messages,embed_links,read_message_history,manage_messages,moderate_members

# Optional third-party Security Bot supervision
# TriadBot only audits Security Bot setup from Discord state. Configure Security Bot rules in its dashboard.
SECURITY_BOT_AUDIT_ENABLED=true
SECURITY_BOT_IDS=651095740390834176
SECURITY_BOT_NAMES=security,security bot
SECURITY_BOT_ROLE_IDS=
SECURITY_BOT_ROLE_NAMES=security
SECURITY_BOT_REQUIRED_PERMISSIONS=administrator
SECURITY_BOT_LOG_CHANNEL_REQUIRED=false
SECURITY_BOT_LOG_CHANNEL_NAMES=security-logs,security-log,mod-logs,audit-log,logs

# Optional server role matching for AI/server actions
MODERATOR_ROLE_IDS=
MODERATOR_ROLE_NAMES=moderator,mod
MODERATOR_ROLE_REQUIRED=false

# Public /request routing
# Leave REQUEST_CHANNEL_IDS blank to auto-detect by channel name.
REQUEST_CHANNEL_IDS=
REQUEST_CHANNEL_NAMES=request,requests,game-request,game-requests,request-game,request-games
REQUEST_PING_ADMINS=true
GAME_REQUESTS_PATH=/data/game_requests.json

# Authorized SQLite-driven Open Directory -> Cloudflare R2 sync
# Keep disabled unless the source directory is yours or you have permission to mirror it.
# Logic: read SQLite games table -> check R2 cache -> request missing AppIDs from the authorized OpenDir API -> clean + upload to R2 as "Game Name (AppID).zip".
OPENDIR_SYNC_ENABLED=false
OPENDIR_BASE_URL=https://www.depotgame.my.id/
OPENDIR_R2_PREFIX=Database/
OPENDIR_STATE_PATH=data/opendir_sync_state.json
OPENDIR_INTERVAL_HOURS=6
OPENDIR_RUN_ON_START=true
OPENDIR_START_DELAY_SECONDS=20
OPENDIR_SOURCE_MODE=api
OPENDIR_API_BASE_URL=https://www.depotgame.my.id/
OPENDIR_API_SEARCH_PATH=/api/search
OPENDIR_API_GENERATE_PATH=/api/generate
OPENDIR_API_DEFAULT_MANIFEST_ID=7884779798207988041
OPENDIR_API_BRANCH=public
OPENDIR_API_DEPOT_KEY=
OPENDIR_API_USE_RYUU_API=true
OPENDIR_API_LOOKUP_BEFORE_GENERATE=true
OPENDIR_API_CLEAN_BEFORE_UPLOAD=true
OPENDIR_API_BUFFER_MAX_MB=50
OPENDIR_API_GENERATE_RETRIES=3
OPENDIR_API_RETRY_DELAY_SECONDS=2
OPENDIR_API_REQUEST_TIMEOUT_SECONDS=900
OPENDIR_API_CONNECT_TIMEOUT_SECONDS=30
OPENDIR_API_READ_TIMEOUT_SECONDS=300

# 0 = check every game in one run. Recommended first test: 100-500.
OPENDIR_GAMES_PER_RUN=500
# 0 = no upload cap. Recommended first test: 20.
OPENDIR_MAX_FILES_PER_RUN=20
OPENDIR_MAX_FILE_MB=1024
OPENDIR_CONCURRENCY=2
OPENDIR_QUEUE_CHUNKS=8
OPENDIR_CHUNK_SIZE_BYTES=1048576
OPENDIR_REQUEST_TIMEOUT_SECONDS=300
OPENDIR_CONNECT_TIMEOUT_SECONDS=30
OPENDIR_READ_TIMEOUT_SECONDS=120

# Index scan parses <a href> links from a real open-directory page.
# Direct probe checks candidate paths from SQLite, such as {appid}.zip and {safe_name} ({appid}).zip.
OPENDIR_INDEX_SCAN_ENABLED=true
OPENDIR_DIRECT_PROBE_ENABLED=true
OPENDIR_USE_HEAD=true
OPENDIR_FALLBACK_GET_PROBE=true
OPENDIR_NOTIFY_ON_SUCCESS=true

# Usually keep target as zip because /gen expects ZIP objects in R2.
OPENDIR_TARGET_EXTENSIONS=zip
OPENDIR_ALLOWED_EXTENSIONS=zip,manifest,lua,acf,vdf
OPENDIR_SOURCE_PATTERNS={appid}.{ext},{appid}/{appid}.{ext},{target_filename},{safe_name}.{ext},{safe_name} ({appid}).{ext}
# Optional host allowlist. Leave blank to allow only OPENDIR_BASE_URL host.
OPENDIR_ALLOWED_HOSTS=
OPENDIR_USER_AGENT=TriadBot OpenDirSync

# AI chat should answer even when live R2/server context collection is slow.
AI_CHAT_RESPONSE_TIMEOUT_SECONDS=60
AI_CHAT_R2_STATS_TIMEOUT_SECONDS=8
AI_CHAT_SERVER_KNOWLEDGE_TIMEOUT_SECONDS=8

# GitHub SQLite backup
GITHUB_BACKUP_ENABLED=true
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxx
GITHUB_REPO=BMNTR/triadbot-db
GITHUB_BRANCH=main
GITHUB_DB_PATH=games.db
GITHUB_DB_METADATA_PATH=games.db.meta.json
GITHUB_BACKUP_INTERVAL_HOURS=12
GITHUB_BACKUP_START_DELAY_SECONDS=90
GITHUB_BACKUP_NOTIFY_ON_SUCCESS=false
GITHUB_BACKUP_TIMEOUT_SECONDS=180

# GitHub SQLite backup chunk size. Keep small for GitHub ruleset validation.
GITHUB_BACKUP_CHUNK_SIZE_MB=8
