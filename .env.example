# AI provider
AI_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_THINK=medium
OLLAMA_KEEP_ALIVE=5m
GEMINI_API_KEY=

# AI caretaker
# Enable only after the selected provider API key is set in Railway.
AI_MAINTENANCE_ENABLED=false
AI_MAINTENANCE_PROVIDER=ollama
AI_MAINTENANCE_MODEL=gpt-oss:120b
AI_MAINTENANCE_INTERVAL_MINUTES=360
AI_MAINTENANCE_ALERT_IDS=
AI_MAINTENANCE_MAX_PROMPT_CHARS=12000
AI_MAINTENANCE_DM_ON_OK=false
AI_MAINTENANCE_DM_ON_WARNING=true
AI_MAINTENANCE_DM_ON_CRITICAL=true
AI_MAINTENANCE_COOLDOWN_SECONDS=900
AI_MAINTENANCE_START_DELAY_SECONDS=20

# Personal DM chat with TriadBot
AI_CHAT_ENABLED=false
AI_CHAT_ALLOWED_IDS=
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=gpt-oss:120b
AI_CHAT_MAX_HISTORY=12
AI_CHAT_MAX_REPLY_CHARS=1800
AI_CHAT_COOLDOWN_SECONDS=3
AI_CHAT_MAX_MESSAGE_CHARS=1800
AI_CHAT_R2_STATS_ENABLED=true
AI_CHAT_R2_STATS_CACHE_SECONDS=900
AI_CHAT_R2_STATS_MAX_PAGES=2000
