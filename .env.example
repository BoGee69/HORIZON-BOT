# ── Discord ───────────────────────────────────────────────
DISCORD_TOKEN=your_discord_bot_token_here

# ── Admin ─────────────────────────────────────────────────
# User ID Discord kamu (bisa lebih dari satu, pisah koma)
ADMIN_IDS=123456789012345678

# ── Cloudflare R2 ─────────────────────────────────────────
# Public URL bucket R2 kamu (tanpa trailing slash)
R2_BASE_URL=https://pub-xxxxxxxxxxxx.r2.dev

# ── Webhook (opsional) ────────────────────────────────────
ADMIN_WEBHOOK=https://discord.com/api/webhooks/...

# ── Bot settings (opsional) ───────────────────────────────
LOG_LEVEL=INFO
BOT_PREFIX=!
CACHE_DAYS=14
ENABLE_AUTO_BACKUP=true
MAX_BACKUPS=5
