# AI caretaker (Gemini)
# Enable only after GEMINI_API_KEY is set in Railway.
AI_MAINTENANCE_ENABLED=false
AI_MAINTENANCE_PROVIDER=gemini
GEMINI_API_KEY=
AI_MAINTENANCE_MODEL=gemini-2.5-flash-lite
AI_MAINTENANCE_INTERVAL_MINUTES=360
AI_MAINTENANCE_ALERT_IDS=
AI_MAINTENANCE_MAX_PROMPT_CHARS=12000
AI_MAINTENANCE_DM_ON_OK=false
AI_MAINTENANCE_DM_ON_WARNING=true
AI_MAINTENANCE_DM_ON_CRITICAL=true
AI_MAINTENANCE_COOLDOWN_SECONDS=900
AI_MAINTENANCE_START_DELAY_SECONDS=20

# Personal DM chat with TriadBot
AI_CHAT_ENABLED=false
AI_CHAT_ALLOWED_IDS=
AI_CHAT_MODEL=gemini-2.5-flash-lite
AI_CHAT_MAX_HISTORY=12
AI_CHAT_MAX_REPLY_CHARS=1800
AI_CHAT_COOLDOWN_SECONDS=3
AI_CHAT_MAX_MESSAGE_CHARS=1800
