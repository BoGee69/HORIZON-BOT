# AI provider
AI_PROVIDER=ollama
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_THINK=medium
OLLAMA_KEEP_ALIVE=5m
GEMINI_API_KEY=

# AI caretaker
# Enable only after the selected provider API key is set in Railway.
AI_MAINTENANCE_ENABLED=false
AI_MAINTENANCE_PROVIDER=ollama
AI_MAINTENANCE_MODEL=gpt-oss:120b
AI_MAINTENANCE_INTERVAL_MINUTES=360
AI_MAINTENANCE_ALERT_IDS=
AI_MAINTENANCE_MAX_PROMPT_CHARS=12000
AI_MAINTENANCE_DM_ON_OK=false
AI_MAINTENANCE_DM_ON_WARNING=true
AI_MAINTENANCE_DM_ON_CRITICAL=true
AI_MAINTENANCE_COOLDOWN_SECONDS=900
AI_MAINTENANCE_START_DELAY_SECONDS=20

# Personal DM chat with TriadBot
AI_CHAT_ENABLED=false
AI_CHAT_ALLOWED_IDS=
# true = user with Discord Administrator permission or ADMIN_ROLE_NAMES/IDS can DM chat with TriadBot
AI_CHAT_ALLOW_DISCORD_ADMINS=true
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=gpt-oss:120b
AI_CHAT_MAX_HISTORY=12
AI_CHAT_MAX_REPLY_CHARS=1800
AI_CHAT_COOLDOWN_SECONDS=3
AI_CHAT_MAX_MESSAGE_CHARS=1800
AI_CHAT_R2_STATS_ENABLED=true
AI_CHAT_R2_STATS_CACHE_SECONDS=900
AI_CHAT_R2_STATS_MAX_PAGES=2000
AI_CHAT_SERVER_REPLIES_ENABLED=true
AI_CHAT_SERVER_REQUIRE_MENTION=true
AI_CHAT_SERVER_KNOWLEDGE_ENABLED=true
AI_CHAT_SERVER_KNOWLEDGE_CACHE_SECONDS=600
AI_CHAT_SERVER_KNOWLEDGE_MAX_MESSAGES=12
AI_CHAT_SERVER_KNOWLEDGE_MAX_CHARS=9000
AI_CHAT_SERVER_KNOWLEDGE_CHANNEL_NAMES=rules,rule,server-rules,resources,resource,panduan,guide,guides,announcement,announcements,pengumuman,link-invite,welcome

# Attachment reading for owner DMs
# Text files/docx/pdf can be read directly. Image OCR needs a vision-capable provider.
AI_ATTACHMENT_ENABLED=true
AI_ATTACHMENT_OCR_ENABLED=true
AI_ATTACHMENT_MAX_BYTES=8388608
AI_ATTACHMENT_MAX_TEXT_CHARS=12000
AI_ATTACHMENT_CACHE_SECONDS=900
AI_ATTACHMENT_VISION_PROVIDER=gemini
AI_ATTACHMENT_VISION_MODEL=gemini-2.5-flash-lite

# Owner-approved AI operator
# The AI can propose whitelisted maintenance actions, but changes run only after owner approval.
AI_OPERATOR_ENABLED=false
AI_OPERATOR_ALLOWED_IDS=
# false by default: admin friends can chat, but only configured owner IDs can approve/execute operator actions.
# Set true only if Discord admins may approve whitelisted proposals too.
AI_OPERATOR_ALLOW_DISCORD_ADMINS=false
AI_OPERATOR_REQUIRE_CONFIRMATION=true
AI_OPERATOR_APPROVAL_TTL_SECONDS=900
AI_OPERATOR_PROPOSAL_COOLDOWN_SECONDS=1800
AI_OPERATOR_MAX_PENDING=10
AI_OPERATOR_ALLOW_R2_MAINTENANCE=true
AI_OPERATOR_ALLOW_STEAM_DB_SYNC=true
AI_OPERATOR_ALLOW_AI_RECHECK=true
AI_OPERATOR_ALLOW_SERVER_AUDIT=true
AI_OPERATOR_ALLOW_BOOSTER_SYNC=true
AI_OPERATOR_ALLOW_SEND_ANNOUNCEMENT=true
AI_OPERATOR_ALLOW_UPDATE_RULES=true
AI_OPERATOR_ALLOW_PIN_MESSAGE=true
AI_OPERATOR_ALLOW_SET_CHANNEL_TOPIC=true
AI_OPERATOR_ALLOW_CREATE_CHANNEL=true
AI_OPERATOR_ALLOW_CONFIGURE_CHANNEL_ACCESS=true

# Discord server caretaker
# Read-only audits can run automatically. Server-changing actions still require owner approval.
SERVER_ADMIN_ENABLED=false
SERVER_ADMIN_GUILD_IDS=
SERVER_ADMIN_AUDIT_ON_START=true
SERVER_ADMIN_AUDIT_INTERVAL_HOURS=6
SERVER_ADMIN_START_DELAY_SECONDS=30
SERVER_ADMIN_ALERT_ON_ISSUES=true
SERVER_ADMIN_RULES_CHANNEL_NAMES=rules,rule,server-rules
SERVER_ADMIN_ANNOUNCEMENT_CHANNEL_NAMES=announcement,announcements,pengumuman
SERVER_ADMIN_REQUIRED_PERMISSIONS=administrator,manage_roles,manage_channels,send_messages,embed_links,read_message_history,manage_messages,moderate_members

# Optional third-party Security Bot supervision
# TriadBot only audits Security Bot setup from Discord state. Configure Security Bot rules in its dashboard.
SECURITY_BOT_AUDIT_ENABLED=true
SECURITY_BOT_IDS=651095740390834176
SECURITY_BOT_NAMES=security,security bot
SECURITY_BOT_ROLE_IDS=
SECURITY_BOT_ROLE_NAMES=security
SECURITY_BOT_REQUIRED_PERMISSIONS=administrator
SECURITY_BOT_LOG_CHANNEL_REQUIRED=false
SECURITY_BOT_LOG_CHANNEL_NAMES=security-logs,security-log,mod-logs,audit-log,logs

# Optional server role matching for AI/server actions
MODERATOR_ROLE_IDS=
MODERATOR_ROLE_NAMES=moderator,mod
MODERATOR_ROLE_REQUIRED=false
